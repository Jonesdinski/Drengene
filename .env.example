# Supabase > Project Settings > API. Public values, safe for browser use.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Supabase > Connect > Session pooler (port 5432, compatible with Postgres.js pipelining), SSL required.
# URL-encode special characters in the database password.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@YOUR_POOLER_HOST:5432/postgres
# Server-only: never prefix these names with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
LEJRBAL_ADMIN_EMAIL=you@example.com
# Canonical deployment origin (update after the first Vercel deployment).
APP_URL=http://localhost:3000
# Optional: restrict entry to a private group of VERIFIED emails.
# Empty = any authenticated, email-verified user may participate.
ALLOWED_EMAILS=
